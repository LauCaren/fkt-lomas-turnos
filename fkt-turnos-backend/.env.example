# Copiar a ".env" y completar/ajustar. Ninguna herramienta lo carga solo (Spring Boot no lee
# .env de fábrica) — hay que exportar estas variables a mano antes de levantar el backend:
#
#   PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
#   Git Bash:    export $(grep -v '^#' .env | xargs)
#
# Ver fkt-turnos-backend/README.md para el detalle de cada variable. Este archivo nunca se
# commitea con valores reales (ver .gitignore) — solo sirve de plantilla.

# --- Obligatorias para que el login/2FA sobrevivan un reinicio del backend ---
# Sin esto, cada arranque genera una clave aleatoria nueva: las sesiones JWT viejas quedan
# inválidas Y los secretos MFA ya guardados en la base quedan indescifrables (el login de
# cualquier cuenta con 2FA activado se rompe con un error interno hasta que se corrige a mano).
JWT_SECRET=dev-jwt-secret-cambiar-por-uno-propio-de-al-menos-48-bytes-0123456789
MFA_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

# --- Cuenta admin inicial (solo se crea si el email todavía no existe) ---
ADMIN_BOOTSTRAP_EMAIL=fernando@fktlomas.com
ADMIN_BOOTSTRAP_PASSWORD=Demo1234!

# --- Base de ejemplo para desarrollo local (pacientes/turnos/caja de prueba) ---
DEMO_DATA_ENABLED=true

# --- Swagger UI / OpenAPI (apagado por defecto — activar solo en dev) ---
SWAGGER_ENABLED=true

# --- Base de datos (default: Postgres de docker-compose.yml) ---
# DB_URL=jdbc:postgresql://localhost:5433/fkt_turnos
# DB_USERNAME=fkt
# DB_PASSWORD=fkt

# --- CORS / URLs (default ya cubre frontend + sitio estático + app de escritorio locales) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500,http://localhost:43117
# FRONTEND_URL=http://localhost:5173

# --- Integraciones opcionales (vacías = esa función queda deshabilitada, no rompe nada) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_NUMERO_ORIGEN_WHATSAPP=
# TWILIO_WEBHOOK_BASE_URL=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=
