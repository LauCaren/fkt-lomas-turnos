{
  "name": "fkt-turnos-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Panel de administración y app de turnos de FKT Lomas",
  "author": "FKT Lomas",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:build-web": "ELECTRON_BUILD=true vite build",
    "electron": "npm run electron:build-web && electron .",
    "desktop:build": "npm run electron:build-web && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/react": "^11.8.0",
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.20.0",
    "buffer": "^6.0.3",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "face-api.js": "^0.22.2",
    "lucide-react": "^1.59.0",
    "nsfwjs": "^4.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4"
  },
  "overrides": {
    "node-fetch": "^2.7.0",
    "qs": "^6.16.0",
    "@capacitor/assets": {
      "@capacitor/cli": "$@capacitor/cli"
    },
    "sharp": "^0.35.5",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.fktlomas.admin",
    "productName": "FKT Lomas Admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://updates.fktlomas.com/",
      "channel": "latest"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "electron/build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/build/icon.png"
    }
  }
}
