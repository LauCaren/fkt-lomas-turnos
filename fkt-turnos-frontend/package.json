{
  "name": "fkt-turnos-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:build-web": "ELECTRON_BUILD=true vite build",
    "electron": "npm run electron:build-web && electron .",
    "desktop:build": "npm run electron:build-web && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.20.0",
    "express": "^4.21.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.fktlomas.admin",
    "productName": "FKT Lomas Admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "dist", "to": "dist" }
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.business",
      "icon": "electron/build/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "electron/build/icon.png"
    }
  }
}
