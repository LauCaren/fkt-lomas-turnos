{
  "name": "fkt-turnos-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Panel de administración y app de turnos de FKT Lomas",
  "author": "FKT Lomas",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:build-web": "ELECTRON_BUILD=true vite build",
    "electron": "npm run electron:build-web && electron .",
    "desktop:build": "npm run electron:build-web && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react": "^8.55.2",
    "axios": "^1.20.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.fktlomas.admin",
    "productName": "FKT Lomas Admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://updates.fktlomas.com/",
      "channel": "latest"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "electron/build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/build/icon.png"
    }
  }
}
